# --- Python environment -----------------------------------------------------
# Contains PyTorch and the whole ultralytics stack -- gigabytes. Recreate with:
#   python -m venv .venv
#   .venv\Scripts\python.exe -m pip install ultralytics opencv-python pyserial platformio
.venv/
__pycache__/
*.pyc

# --- Downloaded model weights -----------------------------------------------
# ultralytics fetches this automatically on first run (~6.5 MB).
yolov8n.pt
*.pt

# --- PlatformIO build output ------------------------------------------------
# Build artifacts plus the downloaded RISC-V toolchain.
# No leading path: a pattern like "firmware/.pio/" is anchored to this file's
# directory and would silently miss "<subfolder>/firmware/.pio/".
.pio/

# --- Captured data ----------------------------------------------------------
# Recorded replay clips are lossless PNG sequences -- tens of MB each.
clips/
snapshots/
baseline_history/
replay-*.csv
# Durable supervisor/alarm event trail -- runtime data, not source.
alerts.jsonl

# --- Site-specific configuration --------------------------------------------
# All three are regenerated for wherever the camera is actually mounted:
#   python lane_detect.py --calibrate   -> zones.json
#   python lane_detect.py --baseline    -> baseline.png, corner_ref.json
# Delete these lines if you'd rather keep your own calibration in the repo.
baseline.png
zones.json
corner_ref.json
markers/

# --- Scratch ----------------------------------------------------------------
*.orig
live_check*.jpg
diagnose.png
*_preview.png
current_view.png
